# Variables PUBLIQUES (intégrées à l'application) : n'y mettez jamais de secret.
# Nom affiché de l'application.
EXPO_PUBLIC_APP_NAME="NutriPlan"
# URL de l'API NutriPlan (depuis un téléphone, utilisez l'adresse IP de votre ordinateur, pas localhost).
EXPO_PUBLIC_API_URL="http://localhost:3000"
# Supabase → Project Settings → API : URL du projet et clé publique (anon / publishable).
EXPO_PUBLIC_SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
