# ── Base de données PostgreSQL ────────────────────────────────────────────────
DATABASE_URL="postgresql://nutriplan:nutriplan@localhost:5432/nutriplan?schema=public"

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
# Origines autorisées pour CORS (séparées par des virgules). Vide = aucune (l'app mobile native n'en a pas besoin).
CORS_ORIGINS="http://localhost:8081"

# ── Supabase Auth (vérification des jetons côté serveur) ──────────────────────
# URL du projet : Supabase → Project Settings → API.
SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
# Facultatif : secret JWT historique (HS256). Si vide, l'API vérifie les jetons
# avec les clés publiques JWKS du projet (clés de signature asymétriques).
SUPABASE_JWT_SECRET=""
# Facultatif, SECRET, serveur uniquement : clé « service_role » / clé secrète,
# utilisée seulement pour supprimer le compte Supabase Auth lors d'une suppression de compte.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Intelligence artificielle (facultatif) ────────────────────────────────────
# Clé API Anthropic, stockée uniquement côté serveur. Vide = fonctionnalité IA désactivée,
# l'application utilise alors la solution de repli fondée sur le catalogue.
ANTHROPIC_API_KEY=""
# Identifiant du modèle Claude à utiliser (liste à jour dans la documentation Anthropic).
AI_MODEL=""
