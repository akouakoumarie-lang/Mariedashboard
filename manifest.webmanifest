{
  "name": "Marie Dashboard",
  "short_name": "Marie",
  "description": "My life, organized. Argent, tâches, carrière, école, voyages, objectifs, prière.",
  "lang": "fr",
  "start_url": "./#/accueil",
  "display": "standalone",
  "background_color": "#17111a",
  "theme_color": "#ff2e8a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "scope": "./",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}